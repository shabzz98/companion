# ===========================================
# OPL CALENDAR / SELF-HOSTED CAL.DIY
# ===========================================

# Public HTTPS URL of the Cal.diy web application.
# Example: https://calendar.example.com
EXPO_PUBLIC_CALCOM_SELF_HOSTED_APP_URL=

# Public HTTPS URL that routes to Cal.diy API v2.
# Preferred form: https://calendar.example.com/api/v2
# The app also accepts a base ending in /api and appends /v2 itself.
EXPO_PUBLIC_CALCOM_SELF_HOSTED_API_V2_URL=

# OAuth client created in Cal.diy under Settings -> Developer -> OAuth.
# Create it as a PUBLIC / PKCE client and allow the redirect URI below.
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID=
EXPO_PUBLIC_CALCOM_OAUTH_REDIRECT_URI=opl-calendar://oauth/callback

# Hosted Cal.com regional settings are retained only for upstream compatibility.
# A dedicated OPL build should leave the EU value blank.
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID_EU=

# Browser-specific OAuth (web/extension only — leave blank for the Android app).
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID_FIREFOX=
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID_FIREFOX_EU=
EXPO_PUBLIC_CALCOM_OAUTH_REDIRECT_URI_FIREFOX=
EXPO_PUBLIC_CALCOM_OAUTH_REDIRECT_URI_FIREFOX_EU=
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID_SAFARI=
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID_SAFARI_EU=
EXPO_PUBLIC_CALCOM_OAUTH_REDIRECT_URI_SAFARI=
EXPO_PUBLIC_CALCOM_OAUTH_REDIRECT_URI_SAFARI_EU=
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID_EDGE=
EXPO_PUBLIC_CALCOM_OAUTH_CLIENT_ID_EDGE_EU=
EXPO_PUBLIC_CALCOM_OAUTH_REDIRECT_URI_EDGE=
EXPO_PUBLIC_CALCOM_OAUTH_REDIRECT_URI_EDGE_EU=

# ===========================================
# CACHE CONFIGURATION (all values in MINUTES)
# ===========================================
EXPO_PUBLIC_CACHE_STALE_TIME_MINUTES=5
EXPO_PUBLIC_CACHE_GC_TIME_MINUTES=1440
EXPO_PUBLIC_BOOKINGS_CACHE_STALE_TIME_MINUTES=5
EXPO_PUBLIC_EVENT_TYPES_CACHE_STALE_TIME_MINUTES=-1
EXPO_PUBLIC_SCHEDULES_CACHE_STALE_TIME_MINUTES=-1
EXPO_PUBLIC_USER_PROFILE_CACHE_STALE_TIME_MINUTES=-1
